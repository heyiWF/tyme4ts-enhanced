{
  "name": "tyme4ts-enhanced",
  "version": "1.13.0",
  "description": "面向通胜（老黄历）场景的 TypeScript 历法引擎：农历、干支、节气、神煞、宜忌、择日、神诞、解梦、九宫飞星、多地区节假日与 ICS 订阅转换，零依赖、易移植。",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.mjs",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "require": "./dist/lib/index.cjs",
      "import": "./dist/lib/index.mjs"
    }
  },
  "scripts": {
    "lint": "eslint",
    "build": "unbuild",
    "test": "mocha -r ts-node/register --config=.mocharc.json",
    "release": "npm run test && npm publish",
    "docs": "npm run build && node -e \"require('fs').copyFileSync('dist/lib/index.mjs','docs/tyme.mjs')\" && node scripts/build-docs-data.mjs",
    "js": "unbuild && node build-js.js",
    "gen:festivals": "python scripts/gen-festival-data.py",
    "verify:festivals": "node scripts/verify-festivals.mjs",
    "audit:holidays": "node scripts/audit-holidays.mjs",
    "gen:conformance": "node scripts/gen-conformance.mjs",
    "gen:malaysia": "node scripts/gen-malaysia-states.mjs"
  },
  "homepage": "https://github.com/heyiWF/tyme4ts-enhanced",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyiWF/tyme4ts-enhanced.git"
  },
  "keywords": [
    "公历",
    "农历",
    "黄历",
    "通胜",
    "老黄历",
    "干支",
    "节气",
    "神煞",
    "宜忌",
    "择日",
    "月将",
    "九宫飞星",
    "二十八宿",
    "神诞",
    "周公解梦",
    "节假日",
    "ics",
    "calendar",
    "almanac",
    "lunar"
  ],
  "author": "6tail <6tail@6tail.cn> (https://6tail.cn)",
  "contributors": [
    "heyiWF"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/heyiWF/tyme4ts-enhanced/issues"
  },
  "devDependencies": {
    "@testdeck/mocha": "^0.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "typescript-eslint": "^8.21.0",
    "eslint": "^9.26.0",
    "mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "unbuild": "^3.3.1",
    "globals": "^15.14.0"
  }
}
